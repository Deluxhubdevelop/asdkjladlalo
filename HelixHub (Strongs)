-- ===== MAIN LOOP =====
local function Start()
    if IsLoopRunning then return end
    IsLoopRunning = true

    task.spawn(function()
        while FollowEnabled do
            task.wait()

            autoEquip()

            local hp = getHPPercent()
            local target = getSelectedPlayerHRP()

            if hp <= FLEE_HP_PERCENT then
                STATE = "FLEE"
            elseif hp >= RETURN_HP_PERCENT then
                STATE = "ATTACK"
            end

            if STATE == "FLEE" then
                flee()
            elseif STATE == "ATTACK" and target then
               fleeBaseY = nil
                tpToTarget(target)
                MoveToTarget(target)
                 FastM1Blade(target)
                 FastM1Blade(target)
                 FastM1Blade(target)
                 FastM1Blade(target)
                 FastM1Blade(target)
            end

            local c = char()
            if c then
                for _, p in ipairs(c:GetDescendants()) do
                    if p:IsA("BasePart") then
                        p.CanCollide = false
                    end
                end
            end
        end

        StopAll()
        IsLoopRunning = false
    end)
end

