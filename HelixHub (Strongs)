-- ===== GET CLOSEST PLAYER IN FOV =====
local function getClosestPlayerInFOV()
    local closest = nil
    local closestDist = FOV_RADIUS
    local center = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y / 2)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if not plr.Character then continue end

        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        local root = plr.Character:FindFirstChild(AIM_PART)
        if not hum or not root or hum.Health <= 0 then continue end

        local screenPos, onScreen = CurrentCamera:WorldToViewportPoint(root.Position)
        if not onScreen then continue end

        local screenVec = Vector2.new(screenPos.X, screenPos.Y)
        local dist = (screenVec - center).Magnitude

        if dist < closestDist then
            closestDist = dist
            closest = root
        end
    end

    return closest
end

-- ===== CAMLOCK LOOP =====
RunService.RenderStepped:Connect(function()
    local center = Vector2.new(CurrentCamera.ViewportSize.X / 2, CurrentCamera.ViewportSize.Y / 2)

    -- Atualiza o círculo sempre (visível só quando camlock ligado)
    fovCircle.Position = center
    fovCircle.Radius = FOV_RADIUS
    fovCircle.Visible = CamlockEnabled

    if not CamlockEnabled then return end

    local target = getClosestPlayerInFOV()
    if not target then return end

    local camPos = CurrentCamera.CFrame.Position
    local cf = CFrame.lookAt(camPos, target.Position)

    if SMOOTHNESS >= 1 then
        CurrentCamera.CFrame = cf
    else
        CurrentCamera.CFrame = CurrentCamera.CFrame:Lerp(cf, SMOOTHNESS)
    end
end)

