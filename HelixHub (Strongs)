-- ===== CHAR UTILS =====
local function char()
    return LocalPlayer.Character
end

local function hrp()
    local c = char()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function humanoid()
    local c = char()
    return c and c:FindFirstChildOfClass("Humanoid")
end

-- ===== AUTO EQUIP TOOL =====
local function autoEquip()
    local c = char()
    if not c then return end

    if c:FindFirstChild(TOOL_NAME) then return end

    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not bp then return end

    local tool = bp:FindFirstChild(TOOL_NAME)
    if tool then
        tool.Parent = c
    end
end

-- ===== HP % =====
local function getHPPercent()
    local hum = humanoid()
    if not hum then return 100 end
    return (hum.Health / hum.MaxHealth) * 100
end

-- ===== GET SELECTED PLAYER HRP =====
local function getSelectedPlayerHRP()
    if not getgenv().PlayerSelecionado then return end

    local plr = Players:FindFirstChild(getgenv().PlayerSelecionado)
    if not plr or not plr.Character then return end

    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    local hr = plr.Character:FindFirstChild("HumanoidRootPart")
    if hum and hr and hum.Health > 0 then
        return hr
    end
end

-- ===== FAST M1 =====
local function FastM1Blade(target)
    if tick() - lastClick < CLICK_DELAY then return end

    local c, h = char(), hrp()
    if not c or not h or not target then return end

    local tool = c:FindFirstChild(TOOL_NAME)
    if not tool then autoEquip() return end

    local remote = tool:FindFirstChild("LeftClickRemote")
    if not remote then return end

    -- Em vez de forçar o CFrame aqui e bugar o movimento, 
    -- apenas calculamos a direção para o Remote
    local dir = (target.Position - h.Position).Unit
    
    -- O Remote precisa saber para onde você quer bater
    remote:FireServer(dir, Combos[comboIndex])

    comboIndex = comboIndex + 1
    if comboIndex > #Combos then
        comboIndex = 1
    end
    lastClick = tick()
end

-- ===== FLEE =====
local function flee()
    local h = hrp()
    if not h then return end

    -- salva a altura só UMA vez
    if not fleeBaseY then
        fleeBaseY = h.Position.Y
    end

    h.CFrame = CFrame.new(
        h.Position.X,
        fleeBaseY + FLEE_HEIGHT,
        h.Position.Z
    )
end

local function MoveToTarget(target)
    if not target then return end
    
    local root = char():FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Pega a direção pro target (horizontalmente, ignora altura se quiser)
    local direction = (target.Position - root.Position)
    -- direction = Vector3.new(direction.X, 0, direction.Z)   ← descomenta se quiser ignorar altura

    if direction.Magnitude < 0.1 then return end   -- evita tremedeira quando tá muito perto

    -- Cria o CFrame olhando pro target
    local lookCFrame = CFrame.new(root.Position, root.Position + direction)

    -- Aplica direto (bem suave e sem delay perceptível)
    root.CFrame = lookCFrame
end

local function tpToTarget(target)
    local h = hrp()
    local hum = humanoid()
    if not h or not hum or not target then return end

    if h:FindFirstChild("MagnetAtt") then return end

    local Attach = Instance.new("Attachment", h)
    Attach.Name = "MagnetAtt"

    hum.PlatformStand = true

    local steppedConn = nil

    task.spawn(function()
        steppedConn = RunService.Stepped:Connect(function()
            if not (FollowEnabled and target and target.Parent and h and h.Parent) then
                steppedConn:Disconnect()
                steppedConn = nil
                StopAll()
                return
            end

            -- Prediz onde o target vai estar no próximo frame
            -- vel * 0.1 = quanto ele anda em ~6 frames (suficiente pra não atrasar)
            local vel = target.AssemblyLinearVelocity
            local predictedPos = target.Position + (vel * 0.1)

            -- Cola na posição predita na frente dele
            local pos = predictedPos + target.CFrame.LookVector * 2.5

            h.CFrame = CFrame.new(pos, target.Position)
            -- Empurra levemente em direção ao target todo frame
            -- garante que o hitbox do M1 sempre toca mesmo que o player vire
            h.AssemblyLinearVelocity = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
        end)
    end)
end

-- ===== STOP =====
local function StopAll()
    local h = hrp()
    local hum = humanoid()
    if not h or not hum then return end

    hum.AutoRotate = true
    hum.PlatformStand = false
    hum:ChangeState(Enum.HumanoidStateType.GettingUp)

    for _, v in ipairs(h:GetChildren()) do
        if v:IsA("Attachment") or v:IsA("AlignOrientation") or v:IsA("LinearVelocity") then
            if v.Name == "MagnetAtt" or v.Name == "MagnetAlign" or v.Name == "MagnetForce" then
                v:Destroy()
            end
        end
    end

    -- Devolve o network pro servidor quando parar
    pcall(function() h:SetNetworkOwner(nil) end)

    h.AssemblyLinearVelocity = Vector3.new()
    h.AssemblyAngularVelocity = Vector3.new()

    print("[StopAll] Tudo limpo e normalizado! ✨")
end

