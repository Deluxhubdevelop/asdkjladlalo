-- ===== VIDA / FUGA =====
local FLEE_HP_PERCENT = 45
local RETURN_HP_PERCENT = 55
local FLEE_HEIGHT = 5000
local MIN_SAFE_DIST = 6
local fleeBaseY = nil

-- ===== FAST M1 =====
local CLICK_DELAY = 0.05
local Combos = {1, 2}
